{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/company-data.js": {
      "maxDuration": 60
    },
    "api/company-page.js": {
      "maxDuration": 60,
      "includeFiles": "financial-ratios.html"
    },
    "api/sitemap.js": {
      "maxDuration": 10
    },
    "api/ai-assistant.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/financial-ratios.html",
      "destination": "/services/financial-ratios",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/company/:symbol",
      "destination": "/api/company-page?symbol=:symbol"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/services/financial-ratios",
      "destination": "/financial-ratios.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
